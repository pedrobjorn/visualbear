{% extends "_layouts/work.nunjucks" %}
{% block title %}visualbear - My Agentic Design Workflow{% endblock %}

{% block description %}How Pedro Björn runs an AI-collaborative design workflow: spec, guardrails, visual validation, and the visuAIbear suite that holds it together.{% endblock %}

{% block bodyattrs %} class="workflow-page"{% endblock %}

{% block config %}
    {% set baseUrl = "../" %}
{% endblock %}

{% import "_modules/molecules/tabs/tabs.nunjucks" as tabsm %}
{% import "styleguide/_styleguide_blocks/styleguide.intro.nunjucks" as intro %}
{% import "styleguide/_styleguide_blocks/styleguide.core.nunjucks" as core %}
{% import "styleguide/_styleguide_blocks/styleguide.modules.nunjucks" as modules %}
{% import "styleguide/_styleguide_blocks/styleguide.containers.nunjucks" as containers %}
{% import "styleguide/_styleguide_blocks/styleguide.casesystem.nunjucks" as casesystem %}

{% block content %}
    <article class="section section-top-padding case-study cs-workflow" id="workflow_container">
        <section class="gallery-container">
            <div class="container">
                <div class="document-text text-box">

                    <!-- visualbear system (specs/visualbear-system, tickets
                         6 + 14, DR-0001/DR-0006): one URL, two tabs. Each
                         panel owns its hero, so exactly one VISIBLE h1
                         exists at any time; the inactive panel is
                         display:none, and the strip lives inside the
                         active panel's hero (see the visuai host below). -->

                    <!-- panel: visuAI tab - owns the page hero (from the
                         page md's front matter, DR-0001) plus the
                         workflow content. The strip lives INSIDE the
                         active panel's hero (ticket 14, DR-0006): its
                         server-rendered home is the host slot below -
                         the controller moves it to the design panel's
                         host on switch. -->
                    <section
                        id="vb-system-panel-visuai"
                        class="vb-panel"
                        role="tabpanel"
                        aria-labelledby="vb-system-tab-visuai"
                        tabindex="-1"
                        data-vb-panel="visuai"
                    >
                        <div data-vb-strip-host="visuai">
                            {{ tabsm.content({
                                id: "vb-system",
                                label: "visualbear system views",
                                active: "visuai",
                                tabs: [
                                    {
                                        id: "visuai",
                                        label: "visuAI"
                                    },
                                    {
                                        id: "designsystem",
                                        label: "Design system"
                                    }
                                ]
                            }) }}
                        </div>
                        <!-- HERO — adapted bare variant (ticket 45, DR-0014):
                             no kicker/"Case Study" (not a case study), no
                             background (the dark ground + spotlight carry
                             it); spacing/type roles are the shared hero's. -->
                        {{ site.data.pages['workflow'] | mdhero | safe }}

                        <!-- content: src/_data/pages/workflow.md via mdpage -->
                        {{ site.data.pages['workflow'] | mdpage | safe }}
                    </section>

                </div>
            </div>
        </section>
    </article>

    <!-- panel: design system tab (ticket 11, DR-0005) - the styleguide
         PAGE itself, rendered as the styleguide page does: a direct child
         of the page, full width - NOT inside the case-study article's
         .document-text.text-box column (that capped demo images at 512px
         and leaked cs-workflow's dark-ground component instances into the
         light panel). The tab controller finds it by [data-vb-panel]. -->
    <section
        id="vb-system-panel-designsystem"
        class="vb-panel"
        role="tabpanel"
        aria-labelledby="vb-system-tab-designsystem"
        tabindex="-1"
        data-vb-panel="designsystem"
        hidden
    >
        <section class="section section-top-padding" id="styleguide_container">
            <!-- the strip's light-state host (ticket 14, DR-0006): the
                 styleguide page's hero container holds the tab; the
                 controller relocates the strip here when this panel is
                 active. The empty host stays zero-height when vacated. -->
            <div data-vb-strip-host="designsystem"></div>
            <article class="text-container">
                <div class="row">
                    {{ intro.content({ title: "Design system" }) }}
                </div>
            </article>
            <article class="text-container" id="core">
                <div class="row">
                    {{ core.content() }}
                </div>
            </article>
            <!-- ticket 38: the panel ships [hidden], so its demo images
                 ship loading="lazy" (they stopped weighing 324KB on every
                 /workflow/ visit) and tabs.js flips them eager on the
                 panel's first activation - the row still renders complete
                 at first tab-open (ticket 16's contract). The standalone
                 /styleguide/ page calls the same blocks WITHOUT lazyDemo
                 and keeps eager loading (recorded decision). -->
            <article class="text-container" id="modules">
                <div class="row">
                    {{ modules.content({lazyDemo: true}) }}
                </div>
            </article>
            <article class="text-container" id="containers">
                <div class="row">
                    {{ containers.content({lazyDemo: true}) }}
                </div>
            </article>
            <article class="text-container" id="casesystem">
                <div class="row">
                    {{ casesystem.content({lazyDemo: true}) }}
                </div>
            </article>
        </section>
    </section>
{% endblock %}
