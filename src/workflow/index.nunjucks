{% extends "_layouts/work.nunjucks" %}
{% block title %}visualbear - My Agentic Design Workflow{% endblock %}

{% block description %}How Pedro Björn runs an AI-collaborative design workflow — spec, guardrails, visual validation — and the visuAIbear suite that holds it together.{% endblock %}

{% block bodyattrs %} class="workflow-page"{% endblock %}

{% block config %}
    {% set baseUrl = "../" %}
{% endblock %}

{% block content %}
    <article class="section section-top-padding case-study cs-workflow" id="workflow_container">
        <section class="gallery-container">
            <div class="container">
                <div class="document-text text-box">

                    <!-- HERO -->
                    <header class="cs-hero">
                        <h1>My Agentic Design Workflow</h1>
                        <p class="cs-wordmark">visu <span>AI</span></p>
                        <p class="cs-cover-summary">
                            Using research, discovery and decisions to create value through my Design AI workflow.
                        </p>
                        <p class="cs-cover-details">Design Lead ⋅ Spec · Skills · Agents ⋅ 2026</p>
                    </header>

					<!-- content: src/_data/pages/workflow.md via mdpage -->
					{{ site.data.pages['workflow'] | mdpage | safe }}

</section>
    </article>
{% endblock %}
