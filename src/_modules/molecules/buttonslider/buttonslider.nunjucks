{% macro content(spec) %}
{% set spec = spec or {} %}
{% set _id = spec.id or '' %}
{% set _class = spec.class or '' %}
{% set _nexthref = spec.nexthref or '#' %}
{% set _prevhref = spec.prevhref or '#' %}
{% set _target = spec.target or '_self' %}
{% set _text = spec.text or 'Default Link' %}
<!-- prev/next pagination: a nav landmark. Note: the nunjucks macro output
     flushes after </main> in the pipeline, so the landmark must be carried
     by this element itself rather than relying on main containment. -->
<nav class="btn-container row" aria-label="Previous / next">
	<div class="col s6">
		{% if _prevhref.link !== "../disabled" %}
			<a href="{{_prevhref.link}}" class="btn vb-btn-full left-align">
				&lt; {{_prevhref.text}}
			</a>
		{% endif %}
	</div>

	<div class="col s6 ">
		{% if _nexthref.link !== "../disabled" %}
			<a href="{{_nexthref.link}}" class="btn vb-btn-full right-align">
				{{_nexthref.text}} &gt; 
			</a>
		{% endif %}
	</div>
</nav>
{% endmacro %}