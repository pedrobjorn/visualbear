{% macro content(spec) %}
{% set spec = spec or {} %}
{% set _class = spec.class or '' %}
<!-- Footer -->
<footer class="foot">
  <section class="container" id="contact">
    <div class="content">
      <div class="row">
        <div class="col s12 m12 text-center">
          <h3>You can contact me at</h3>
          <h3>
          <a href="mailto:hello@visualbear.com?Subject=Hello%20visualbear!" target="_top">hello@visualbear.com</a>
          </h3>
        </div>
      </div>
    </div>
  </section>
  <section class="container--padded">
    <ul class="socialContainer">
      <li>
        <a href="https://www.linkedin.com/in/pedro-johan-bjorn-7417324b" class="vb-btn-icon " title="Visit LinkedIn" target="_blank">
          <img src="/images/icons/linkdin_icon_64.jpg" alt="LinkedIn Icon" width="48" height="48">
        </a>
      </li>
    </ul>
  </section>
  <!-- a second contentinfo landmark is not allowed; this is styled text -->
  <div class="foot-copyright">
    <div class="text-center">
      <p>Made by Pedro Bj&#246;rn with paws and vibes. </p>
      <p>&copy; 2026 visualbear All Rights Reserved.</p>
      <p style="padding:16px 0;">
        <a href="https://assets.fastcompany.com/image/upload/w_596,c_limit,q_auto:best,f_auto,fl_lossy/fc/3033256-inline-i-bearpage.png" title="All rights belong to USA Today." style="text-decoration: none;" target="_blank">🐻</a>
        <a href="../workflow/" title="My agentic design workflow" style="text-decoration: none;">🤖</a>
      </p>
    </div>
  </div>
</footer>
{% endmacro %}