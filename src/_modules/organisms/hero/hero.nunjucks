{% macro content(spec) %}
{% set spec = spec or {} %}
{% set _class = spec.class or '' %}
{% set _content = spec.content or '' %}
<div class="hero {{_class}}">
	<div class="content">
		{# h1: the hero line is the page title on every page that uses this macro #}
		<h1 class="jumbo-text">
			{{_content.title}}
		</h1>
	</div>
</div>
{% endmacro %}