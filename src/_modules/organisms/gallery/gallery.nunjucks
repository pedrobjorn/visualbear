{% macro content(spec) %}
{% import "_modules/molecules/card/card.nunjucks" as card %}

{% set spec = spec or {} %}
{% set site = site or {} %}
{% set _class = spec.class or '' %}
{% set _contentType = spec.contentType or 'work' %}
{% set _content = spec.content or '[{}]' %}
{% set spec = spec or {} %}
{% set _id = spec.id or '' %}
{% set _class = spec.class or '' %}
{% set _href = spec.href or '#' %}
{% set _target = spec.target or '_self' %}
{% set _title = spec.title or 'Default Link' %}
{% set _subtitle = spec.subtitle or 'Default Link' %}
{% set _showPlay = true %}
{% if spec.showPlay == false %}
{% set _showPlay = false %}
{% endif %}
{% set _showBlog = true %}
{% if spec.showBlog == false %}
{% set _showBlog = false %}
{% endif %}

{% set _playCard = {
    "title": "Play",
    "subtitle": "Illustration & Graphic design fun",
    "href": "../play",
    "img": "../images/work/thumbs/"
} %}
{% set _blogCard = {
    "title": "Blog",
    "subtitle": "Ramblings",
    "href": "../blog",
    "img": "../images/work/thumbs/"
} %}

<div class="content gallery">

{% if _contentType == 'work' %}

<div style="width:100%">
{% for val in _content %}

{{card.content({card:val})}}
{% endfor %}

<!-- Play gallery option -->
{% if _showPlay %}
{{card.content({card:_playCard})}}
{% endif %}

<!-- Blog gallery option -->
{% if _showBlog %}
{{card.content({card:_blogCard})}}
{% endif %}
</div>

{% elif _contentType == 'play' %}
<div style="width:100%">
{% for val in _content %}

{{card.content({card:val})}}

{% endfor %}
</div>

{% elif _contentType == 'blog' %}
<div style="width:100%">
{% for val in _content %}

{{card.content({card:val})}}

{% endfor %}
</div>

{% endif %}
</div>
{% endmacro %}