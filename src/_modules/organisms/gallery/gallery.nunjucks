{% macro content(spec) %}
{% import "_modules/molecules/card/card.nunjucks" as card %}

{% set spec = spec or {} %}
{% set site = site or {} %}
{% set _class = spec.class or '' %}
{% set _contentType = spec.contentType or 'work' %}
{% set _content = spec.content or '[{}]' %}
{% set spec = spec or {} %}
{% set _id = spec.id or '' %}
{% set _class = spec.class or '' %}
{% set _href = spec.href or '#' %}
{% set _target = spec.target or '_self' %}
{% set _title = spec.title or 'Default Link' %}
{% set _subtitle = spec.subtitle or 'Default Link' %}
{% set _showPlay = true %}
{% if spec.showPlay == false %}
{% set _showPlay = false %}
{% endif %}
{% set _showBlog = true %}
{% if spec.showBlog == false %}
{% set _showBlog = false %}
{% endif %}

{# play-subpages T2 (DR-0003): the in-gallery Play card. id="play-teaser"
   is the mirror strip's target (stripPlayTeaser in scripts/mirror-link.js).
   img defaults to an existing shipped thumb (ASSUMPTION - Pedro; H2). #}
{% set _playCard = {
    "title": "Play",
    "subtitle": "Stuff I do for fun",
    "href": "../play",
    "img": "../images/work/thumbs/gallery_thumb_prettyugly.jpg"
} %}
{% set _blogCard = {
    "title": "Blog",
    "subtitle": "Ramblings",
    "href": "../blog",
    "img": "../images/work/thumbs/"
} %}

<div class="content gallery">

{% if _contentType == 'work' %}

<div style="width:100%">
{% for val in _content %}
{# Ticket 25 (amend pass 2026-11-13b): per-entry hide flag - the data
   stays for a later re-show; covers public + mirror homes (same data) #}
{# Ticket 25 amend (2026-11-13b, re-add): entries flagged "bottom"
   (the re-added closet card) render AFTER the Play/Blog options -
   Pedro: "at the bottom of the cards in the index" #}
{% if not val.hidden and not val.bottom %}
{{card.content({card:val})}}
{% endif %}
{% endfor %}

<!-- Blog gallery option -->
{% if _showBlog %}
{{card.content({card:_blogCard})}}
{% endif %}

{% for val in _content %}
{% if not val.hidden and val.bottom %}
{{card.content({card:val})}}
{% endif %}
{% endfor %}

{# Play gallery option: the LAST card in the gallery (play-subpages T2,
   DR-0005). Slim via the macro's class passthrough; id="play-teaser" is
   the mirror strip target (stripPlayTeaser) #}
{% if _showPlay %}
{{card.content({id:"play-teaser", class:"card--thin", card:_playCard})}}
{% endif %}
</div>

{% elif _contentType == 'play' %}
<div style="width:100%">
{% for val in _content %}

{{card.content({card:val})}}

{% endfor %}
</div>

{% elif _contentType == 'blog' %}
<div style="width:100%">
{% for val in _content %}

{{card.content({card:val})}}

{% endfor %}
</div>

{% elif _contentType == 'photogrid' %}
{# play-subpages T10 (DR-0002): textless grid cells fed by
   site.data.photogallery (T8). The anchor keeps the full image as href
   (no-JS fallback opens the image); JS intercepts via the data-lb-* hooks
   (T15). img/href are depth-2 relative: this branch only renders on
   /play/photography/ #}
<div class="gallery-grid">
{% for val in _content %}
{{card.content({card: {title: val.title, img: '../../images/play/photography/' + val.file, href: '../../images/play/photography/' + val.file}, grid: true, notext: true, lightbox: true, index: loop.index0})}}
{% endfor %}
</div>

{# play-subpages T17: the full-size view of the same photos - stacked
   full-width images, natural size, the page scrolls. Shares the data-lb-*
   hooks so the lightbox (T15) opens from this view too and the no-JS href
   fallback stays. Hidden by default; the .photoview-switch toggles it. #}
<div class="gallery-full" hidden>
{% for val in _content %}
<a class="photofull-item" href="../../images/play/photography/{{val.file}}" data-lb-index="{{loop.index0}}" data-lb-img="../../images/play/photography/{{val.file}}" data-lb-title="{{val.title}}">
  <img src="../../images/play/photography/{{val.file}}" alt="{{val.title}}" loading="lazy">
</a>
{% endfor %}
</div>

{% endif %}
</div>
{% endmacro %}