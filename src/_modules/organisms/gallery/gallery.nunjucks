{% macro content(spec) %}
{% import "_modules/molecules/card/card.nunjucks" as card %}

{% set spec = spec or {} %}
{% set site = site or {} %}
{% set _class = spec.class or '' %}
{% set _contentType = spec.contentType or 'work' %}
{% set _content = spec.content or '[{}]' %}
{% set spec = spec or {} %}
{% set _id = spec.id or '' %}
{% set _class = spec.class or '' %}
{% set _href = spec.href or '#' %}
{% set _target = spec.target or '_self' %}
{% set _title = spec.title or 'Default Link' %}
{% set _subtitle = spec.subtitle or 'Default Link' %}
{% set _showPlay = true %}
{% if spec.showPlay == false %}
{% set _showPlay = false %}
{% endif %}
{% set _showBlog = true %}
{% if spec.showBlog == false %}
{% set _showBlog = false %}
{% endif %}

{# play-subpages T2 (DR-0003): the in-gallery Play card. id="play-teaser"
   is the mirror strip's target (stripPlayTeaser in scripts/mirror-link.js).
   img defaults to an existing shipped thumb (ASSUMPTION - Pedro; H2). #}
{% set _playCard = {
    "title": "Play",
    "subtitle": "Stuff I do for fun",
    "href": "../play",
    "img": "../images/work/thumbs/gallery_thumb_prettyugly.jpg"
} %}
{% set _blogCard = {
    "title": "Blog",
    "subtitle": "Ramblings",
    "href": "../blog",
    "img": "../images/work/thumbs/"
} %}

<div class="content gallery">

{% if _contentType == 'work' %}

<div style="width:100%">
{% for val in _content %}
{# Ticket 25 (amend pass 2026-11-13b): per-entry hide flag - the data
   stays for a later re-show; covers public + mirror homes (same data) #}
{# Ticket 25 amend (2026-11-13b, re-add): entries flagged "bottom"
   (the re-added closet card) render AFTER the Play/Blog options -
   Pedro: "at the bottom of the cards in the index" #}
{% if not val.hidden and not val.bottom %}
{{card.content({card:val})}}
{% endif %}
{% endfor %}

<!-- Blog gallery option -->
{% if _showBlog %}
{{card.content({card:_blogCard})}}
{% endif %}

{% for val in _content %}
{% if not val.hidden and val.bottom %}
{{card.content({card:val})}}
{% endif %}
{% endfor %}

{# Play gallery option: the LAST card in the gallery (play-subpages T2,
   DR-0005). Slim via the macro's class passthrough; id="play-teaser" is
   the mirror strip target (stripPlayTeaser) #}
{% if _showPlay %}
{{card.content({id:"play-teaser", class:"card--thin", card:_playCard})}}
{% endif %}
</div>

{% elif _contentType == 'play' %}
<div style="width:100%">
{% for val in _content %}

{{card.content({card:val})}}

{% endfor %}
</div>

{% elif _contentType == 'blog' %}
<div style="width:100%">
{% for val in _content %}

{{card.content({card:val})}}

{% endfor %}
</div>

{% endif %}
</div>
{% endmacro %}