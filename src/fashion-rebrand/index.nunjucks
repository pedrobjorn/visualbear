{% extends "_layouts/work.nunjucks" %}
{% import "_modules/organisms/headline/headline.nunjucks" as headline %}
{% import "_modules/molecules/buttonslider/buttonslider.nunjucks" as buttonslider %}
{% block config %}
    {% set baseUrl = "../" %}
{% endblock %}
{% block content %}
    <article class="section section-top-padding" id="fashion_rebrand_container">
        <section class="gallery-container">
            <div class="black-bg">
                {{headline.content({content:site.data.project_fashion_rebrand})}}
                <img src="../images/work/thumbs/gallery_thumb_fashion.jpg" title="Fashion Rebrand" width="100%" height="100%" style="margin-bottom:-12px">
            </div>
            <div class="container">
                <div class="document-text text-box">
                    <!-- 01 HERO -->
                    <section class="hero-section">
                        <p class="eyebrow">Case Study — Fashion Rebrand</p>
                        <h1>Relaunching a Fashion Brand Experience on Web</h1>
                        <p class="subtitle">Rebuilding a global fashion retailer's entrances — Start Page and Department navigation — to lift brand perception and move customers down the funnel.</p>
                        <p class="byline">Pedro Björn · Staff Designer, Lead Web UX · 9 months · 2 pilot markets</p>
                        
                        <div class="metrics-container">
                            <div class="metric-card">
                                <span class="metric-value" data-countup="27">0</span><span class="metric-suffix">%</span>
                                <span class="metric-label">sessions ↑ (330k→450k/mo)</span>
                            </div>
                            <div class="metric-card">
                                <span class="metric-value" data-countup="14">0</span><span class="metric-suffix">%</span>
                                <span class="metric-label">single-page sessions ↓</span>
                            </div>
                            <div class="metric-card">
                                <span class="metric-value" data-countup="11">0</span><span class="metric-suffix">%</span>
                                <span class="metric-label">exit rate ↓</span>
                            </div>
                            <div class="metric-card">
                                <span class="metric-value" data-countup="40">0</span><span class="metric-suffix">%</span>
                                <span class="metric-label">faster pages</span>
                            </div>
                        </div>
                        <p class="summary-bar"><em>~20k more customers/mo continued toward transaction.</em></p>
                    </section>

                    <!-- 02 CONTEXT -->
                    <section class="context-section">
                        <h2>Context</h2>
                        <div class="context-columns">
                            <div class="context-column">
                                <h3>Problem</h3>
                                <p>Brand read as retail, not fashion → dropping recognition/sales/retention</p>
                            </div>
                            <div class="context-column">
                                <h3>Customer</h3>
                                <p>Fashionista, 18–34, a Validator; hypothesis: win trendsetters → mainstream follows</p>
                            </div>
                            <div class="context-column">
                                <h3>Team</h3>
                                <p>Senior Core Team (3 brand, 2 UI, 3 UX, 2 DS, 2 research, 3 PM); me = Lead Web UX.</p>
                                <p class="footnote"><em>*too centralised/waterfall; teams should contribute earlier.</em></p>
                            </div>
                        </div>
                    </section>

                    <!-- 03 PROCESS -->
                    <section class="process-section">
                        <h2>Process</h2>
                        <div class="process-timeline">
                            <div class="process-card">
                                <span class="process-number">01</span>
                                <h3>Planning & Strategy</h3>
                                <p>Mapped opportunities to journey phases; impact-map prioritisation; top-3 concepts on Web; desirability study validated</p>
                            </div>
                            <div class="process-card">
                                <span class="process-number">02</span>
                                <h3>Exploration & Vision</h3>
                                <p>Web + visual guidelines, breakpoints, layout rules</p>
                            </div>
                            <div class="process-card">
                                <span class="process-number">03</span>
                                <h3>Design Guidance</h3>
                                <p>Team support, formal pre-dev review, Ready-for-Development standard</p>
                            </div>
                            <div class="process-card">
                                <span class="process-number">04</span>
                                <h3>Design QA</h3>
                                <p>Shared board, per-team tables, ~50 issues in 2 weeks; built on two designers' methods, credited</p>
                            </div>
                        </div>
                    </section>

                    <!-- 04 DEEP-DIVE: ENTRANCES -->
                    <section class="deepdive-section">
                        <h2>Deep-Dive: Entrances</h2>
                        <p><strong>Problem:</strong> Early exits from Department pages; nav always started at top level (redundant); unfocused landing → bounce</p>
                        <p><strong>Hypothesis:</strong> Index Page = Women's Department, other departments as tabs; Kids+Babies merged into Kids (huge SEO/working impact)</p>
                        
                        <div class="mockup-comparison">
                            <div class="mockup-before">
                                <h3>Start Page - Before</h3>
                                <p>Cluttered index, heavy nav</p>
                                <!-- Placeholder for before mockup -->
                                <div class="mockup-placeholder" style="background: #e0e0e0; height: 300px; border: 1px solid #ccc;">
                                    <p style="text-align: center; padding-top: 120px;">Before Mockup</p>
                                </div>
                                <div class="annotation">
                                    <span class="annotation-dot"></span>
                                    <p>Overwhelming navigation options</p>
                                </div>
                            </div>
                            <div class="mockup-after">
                                <h3>Start Page - After</h3>
                                <p>Women's dept, tab bar (Women·Men·Kids·Home·Beauty), bigger media, bolder type, less copy</p>
                                <!-- Placeholder for after mockup -->
                                <div class="mockup-placeholder" style="background: #f5f5f5; height: 300px; border: 1px solid #ccc;">
                                    <p style="text-align: center; padding-top: 120px;">After Mockup</p>
                                </div>
                                <div class="annotation">
                                    <span class="annotation-dot"></span>
                                    <p>Simplified tab navigation</p>
                                </div>
                            </div>
                        </div>
                        
                        <div class="mockup-comparison">
                            <div class="mockup-before">
                                <h3>Navigation - Before</h3>
                                <p>Desktop hover mega-menu</p>
                                <div class="mockup-placeholder" style="background: #e0e0e0; height: 200px; border: 1px solid #ccc;">
                                    <p style="text-align: center; padding-top: 80px;">Before Nav</p>
                                </div>
                            </div>
                            <div class="mockup-after">
                                <h3>Navigation - After</h3>
                                <p>Progressive disclosure; mobile = horizontal dept tabs anchored to header, hidden on scroll-down, shown on scroll-up</p>
                                <div class="mockup-placeholder" style="background: #f5f5f5; height: 200px; border: 1px solid #ccc;">
                                    <p style="text-align: center; padding-top: 80px;">After Nav</p>
                                </div>
                                <div class="annotation">
                                    <span class="annotation-dot"></span>
                                    <p>Mobile-friendly progressive disclosure</p>
                                </div>
                            </div>
                        </div>
                        
                        <p><strong>Validation:</strong> 9 participants (21–37, DE/UK/US, remote moderated, old+new on App/Mobile/Desktop).</p>
                        <ul>
                            <li>Tab nav intuitive ✓</li>
                            <li>Mobile benefited most</li>
                            <li>App vs Web need different menus</li>
                            <li>Fewer depts = less complexity</li>
                            <li>Some users missed desktop mega-menu</li>
                        </ul>
                        <p><strong>Delivery:</strong> 2 teams (Entrances = me, Navigation), one experience; Dept Tab = single shared component across header + menu, mobile + desktop</p>
                    </section>

                    <!-- 05 OUTCOMES -->
                    <section class="outcomes-section">
                        <h2>Outcomes (May 3–31 YoY, pilot — early but promising)</h2>
                        <table class="outcomes-table">
                            <thead>
                                <tr>
                                    <th>Metric</th>
                                    <th>Before</th>
                                    <th>After</th>
                                    <th>Change</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Sessions</td>
                                    <td>330k</td>
                                    <td>450k</td>
                                    <td>+~27%</td>
                                </tr>
                                <tr>
                                    <td>Single-page sessions</td>
                                    <td>10%</td>
                                    <td>8.5%</td>
                                    <td>−~14% (~11k more multi-page sessions)</td>
                                </tr>
                                <tr>
                                    <td>Exit rate</td>
                                    <td>15%</td>
                                    <td>13%</td>
                                    <td>−~11% (~9k fewer exits)</td>
                                </tr>
                                <tr>
                                    <td>Performance</td>
                                    <td>baseline</td>
                                    <td>+40%</td>
                                    <td>+~40%</td>
                                </tr>
                                <tr>
                                    <td>SEO</td>
                                    <td colspan="3">↑</td>
                                </tr>
                            </tbody>
                        </table>
                        <p>Also: BUs happier w/ discoverability + content guidelines; campaign production time/cost halved.</p>
                        <p class="caveat"><em>*could have done more quantification to separate design impact from season/marketing effects.</em></p>
                    </section>

                    <!-- 06 LESSONS & RELEVANCE -->
                    <section class="lessons-section">
                        <h2>Lessons & Relevance</h2>
                        <div class="lessons-columns">
                            <div class="lessons-column">
                                <h3>Lessons</h3>
                                <ul>
                                    <li>Learn early/often to de-risk</li>
                                    <li>Include teams earlier, committee design harms culture</li>
                                    <li>Visible navigation beats hidden</li>
                                </ul>
                            </div>
                            <div class="lessons-column">
                                <h3>Staff Designer relevance</h3>
                                <ul>
                                    <li>Cross-dept navigation at scale</li>
                                    <li>Brand integrated into product</li>
                                    <li>Uniting teams on shared missions</li>
                                </ul>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
            {{buttonslider.content({
            nexthref: site.data.project_fashion_rebrand.nexthref,
            prevhref: site.data.project_fashion_rebrand.prevhref,
            text: var.linkname
            })}}
        </section>
    </article>
{% endblock %}
