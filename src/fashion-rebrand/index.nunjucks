{% extends "_layouts/work.nunjucks" %}
{% import "_modules/organisms/headline/headline.nunjucks" as headline %}
{% import "_modules/molecules/buttonslider/buttonslider.nunjucks" as buttonslider %}
{% block config %}
    {% set baseUrl = "../" %}
{% endblock %}
{% block content %}
    <article class="section section-top-padding" id="fashion_rebrand_container">
        <section class="gallery-container">
            <div class="black-bg">
                {{headline.content({content:site.data.project_fashion_rebrand})}}
                <img src="../images/work/thumbs/gallery_thumb_fashion.jpg" title="Fashion Rebrand" width="100%" height="100%" style="margin-bottom:-12px">
            </div>
            <div class="container">
                <div class="document-text text-box">
                    <a href="https://drive.google.com/file/d/1XeZi2BfcTFRr2HSVrUE8MFVx-JGd5hiu/view?usp=sharing" target="_blank" class="card-link">
                        <div class="row">
                            <div class="col s12 m12">
                                <div class="card-container card medium">
                                    <div class="card-container card-image" style="background-image: url(../images/work/thumbs/gallery_thumb_fashion.jpg)">
                                        <span class="card-title">
                                            <h2>View the PDF case study</h2>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </a>
                    <p>Project page coming soon...</p>
                </div>
            </div>
            {{buttonslider.content({
            nexthref: site.data.project_fashion_rebrand.nexthref,
            prevhref: site.data.project_fashion_rebrand.prevhref,
            text: var.linkname
            })}}
        </section>
    </article>
{% endblock %}
