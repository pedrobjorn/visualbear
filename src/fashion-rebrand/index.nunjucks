{% extends "_layouts/work.nunjucks" %}
{% import "_modules/molecules/buttonslider/buttonslider.nunjucks" as buttonslider %}
{% block title %}visualbear - Relaunching a Fashion Brand Experience on Web{% endblock %}
{% block config %}
    {% set baseUrl = "../" %}
{% endblock %}
{% block bodyattrs %} class="cs-black-page"{% endblock %}
{% block content %}
    <article class="section section-top-padding case-study cs-black" id="fashion_rebrand_container">
        <section class="gallery-container">
            <div class="container">
                <div class="document-text text-box">

                    <!-- 01 HERO, full-bleed black cover -->
                    <header class="cs-hero cs-hero--black">
                        <p class="cs-eyebrow">Case Study</p>
                        <h1>Relaunching a Fashion Brand Experience on Web</h1>
                        <p class="cs-cover-summary">
                            Rebuilding a global fashion retailer's entrances, the Start Page and Department navigation, to lift brand perception and move customers further down the funnel.
                        </p>
                        <p class="cs-cover-details">H&amp;M ⋅ Staff Designer ⋅ Web Global Redesign ⋅ 9 months</p>
                    </header>

                    <!-- HERO META, metrics & result -->
                    <section class="cs-hero cs-hero--meta">
                        <div class="cs-metrics">
                            <div class="cs-metric">
                                <span class="cs-metric-value" data-countup="20">20</span><span class="cs-metric-suffix">k</span>
                                <span class="cs-metric-label">new users per month*</span>
                            </div>
                            <div class="cs-metric">
                                <span class="cs-metric-value" data-countup="14">14</span><span class="cs-metric-suffix">%</span>
                                <span class="cs-metric-label">single-page sessions <i class="ph ph-arrow-down"></i>**</span>
                            </div>
                            <div class="cs-metric">
                                <span class="cs-metric-value" data-countup="27">27</span><span class="cs-metric-suffix">%</span>
                                <span class="cs-metric-label">new sessions <i class="ph ph-arrow-up"></i>**</span>
                            </div>
                        </div>
                        <p class="cs-footnote">* for two pilot markets &nbsp;·&nbsp; ** vs last year, May 3–31, across Landing &amp; Department pages</p>
                        <p class="cs-summary"><em>More sessions, fewer single-page sessions and fewer exits, up to ~20k more customers per month continued down the funnel toward transaction.</em></p>
                    </section>

                    {{ site.data.pages['fashion-rebrand'] | mdpage | safe }}
                </div>
            </div>
            {{buttonslider.content({
            nexthref: site.data.project_fashion_rebrand.nexthref,
            prevhref: site.data.project_fashion_rebrand.prevhref,
            text: var.linkname
            })}}
        </section>
    </article>
{% endblock %}
