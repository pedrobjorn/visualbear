{% extends "_layouts/work.nunjucks" %}
{% import "_modules/molecules/buttonslider/buttonslider.nunjucks" as buttonslider %}
{% block title %}visualbear - Teachr, AI Agent embedded in the Learning Dashboard{% endblock %}

{% block description %}Pedro Björn Portfolio website{% endblock %}

{% block bodyattrs %} class="cs-teal-page"{% endblock %}

{% block config %}
    {% set baseUrl = "../" %}
{% endblock %}

{% block content %}
    <article class="section section-top-padding case-study cs-teal" id="teachr_agent_container">
        <section class="gallery-container">
            <div class="container">
                <div class="document-text text-box">

                    <!-- 01 HERO, full-bleed teal cover -->
                    <header class="cs-hero cs-hero--teal">
                        <p class="cs-eyebrow">Case Study — Teachr (mock brand)</p>
                        <h1>Teachr, AI Agent embedded in the Learning Dashboard</h1>
                        <p class="cs-cover-summary">
                            Unlocking the training dashboard experience for our users through agentic AI in the app.
                        </p>
                        <p class="cs-cover-details">Lead Designer ⋅ Figjam · Claude Code</p>
                    </header>

                    <!-- HERO META, brand & related case study -->
                    <section class="cs-hero cs-hero--meta">
                        <img src="../images/work/fullsize/teachr/teachr_logo.png" alt="Teachr brand mark" width="19" height="19" style="display:block;width:19px;height:19px;margin:0 auto 24px">
                        <div class="cs-cards">
                        <p class="cs-related">
                            Part of a pair — read first: <a href="../teachr/"><strong>Teachr, Redesigning the Learning Experience</strong></a> <i class="ph ph-arrow-left"></i>
                        </p>
                        </div>
                        <p class="cs-summary"><em>Summary: unlocking the training dashboard experience for our users through agentic AI in the app.</em></p>
                    </section>

                    					<!-- content sections: src/_data/pages/teachr-agent.md via mdpage -->
					{{ site.data.pages['teachr-agent'] | mdpage | safe }}

</section>
                </div>
            </div>
            {{buttonslider.content({
            nexthref: site.data.project_teachr_agent.nexthref,
            prevhref: site.data.project_teachr_agent.prevhref,
            text: var.linkname
            })}}
        </section>
    </article>
{% endblock %}
