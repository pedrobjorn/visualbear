{% extends '_layouts/gallery.nunjucks' %}

{% import "_modules/organisms/gallery/gallery.nunjucks" as gallery %}
{% import "_modules/molecules/lightbox/lightbox.nunjucks" as lightbox %}

{% block config %}
  {# Correct base url pathing for this page (depth 2) #}
  {% set baseUrl = '../../' %}
{% endblock %}

{# play-subpages T19 (DR-0006): opt this page out of the red brand body
   gradient - body.page-photography paints the dark grey gradient instead #}
{% block bodyattrs %} class="page-photography"{% endblock %}

{% block content %}
{# play-subpages T14 (DR-0002): no hero on this page - just the photogrid
   fed by site.data.photogallery (T8 folder scan, newest first). The dialog
   markup (T13) renders hidden; the controller (T15) reads #photogrid-data.
   T17: the view switch (grid / full size); .photoview pads under the fixed
   48px nav and the switch bar sticks below it on scroll. #}

<div class="photoview">
  {# play-subpages T19 (DR-0006): the page h1 - the page had no heading at
     all; light ink so it matches the dark grey gradient ground #}
  <h1 class="photoview-title">Photography</h1>
  <div class="photoview-switch" role="group" aria-label="Photo view">
    <button type="button" class="photoview-btn" data-view="grid" aria-pressed="true">Grid</button>
    <button type="button" class="photoview-btn" data-view="full" aria-pressed="false">Full size</button>
  </div>

{{gallery.content({content: site.data.photogallery, contentType: 'photogrid'})}}
</div>

{{lightbox.content({})}}

<script type="application/json" id="photogrid-data">{{ site.data.photogallery | dump | safe }}</script>

{% endblock %}
