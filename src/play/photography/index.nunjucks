{% extends '_layouts/play.nunjucks' %}

{% import "_modules/organisms/gallery/gallery.nunjucks" as gallery %}
{% import "_modules/organisms/hero/hero.nunjucks" as hero %}
{% import "_modules/molecules/lightbox/lightbox.nunjucks" as lightbox %}

{% block config %}
  {# Correct base url pathing for this page (depth 2) #}
  {% set baseUrl = '../../' %}
{% endblock %}

{# play-consistency T2 (DR-0002): shares the one dark play gradient;
   play-menu-hero T2 (DR-0002): play-photos scopes the photogrid spacer #}
{% block bodyattrs %} class="page-play play-photos"{% endblock %}

{% block content %}
{# play-menu-hero T2 (DR-0002): the page adopts the shared hero organism -
   photohero.yml, h1 "Photography"; the old bare h1.photoview-title is
   deleted, so the page keeps exactly one h1. The hero occupies the top, so
   .photoview no longer pads under the nav.
   play-menu-hero T7 (DR-0004): the hero fills the region between the header
   and the content (hero--fill, hero.scss - 48px nav .. 48vh), so the title
   is visually centered between header and body; replaces the wired but
   unshipped hero--roomy. The spacer lives on .photoview (gallery.scss),
   so the switch bar renders BETWEEN the title and the photogrid at rest;
   on scroll it stays sticky at top: 80px (48px nav + 32px gap).
   Below: the photogrid fed by site.data.photogallery (play-subpages
   T8 folder scan, newest first), the hidden dialog markup (T13) read by
   the controller (T15), and the T17 view switch. #}
{{hero.content({content:site.data.photohero, class:'hero--fill hero--center'})}}

<div class="photoview">
  <div class="photoview-switch" role="group" aria-label="Photo view">
    <button type="button" class="photoview-btn" data-view="grid" aria-pressed="true">Grid</button>
    <button type="button" class="photoview-btn" data-view="full" aria-pressed="false">Full size</button>
  </div>

{{gallery.content({content: site.data.photogallery, contentType: 'photogrid'})}}
</div>

{{lightbox.content({})}}

<script type="application/json" id="photogrid-data">{{ site.data.photogallery | dump | safe }}</script>

{% endblock %}
