{% extends '_layouts/play.nunjucks' %}


{% import "_modules/atom/link/link.nunjucks" as link %}
{% import "_modules/organisms/gallery/gallery.nunjucks" as gallery %}

{% import "_modules/organisms/hero/hero.nunjucks" as hero %}

{% block config %}
  {# Correct base url pathing for this page #}
  {% set baseUrl = '../../' %}
{% endblock %}

{# play-consistency T2 (DR-0002): shares the one dark play gradient
   (body.page-play) - the page-anchored layer keeps it from re-tiling.
   play-menu-hero T2 (DR-0002): play-blog scopes the blog hero + spacer (T3) #}
{% block bodyattrs %} class="page-play play-blog"{% endblock %}

{% block content %}

{{hero.content({content:site.data.bloghero,class:hero-about})}}

{{gallery.content({content:site.data.blog, contentType:'blog'})}}

{% endblock %}
