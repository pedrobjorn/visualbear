{% extends "_layouts/work.nunjucks" %}
{% import "_modules/molecules/buttonslider/buttonslider.nunjucks" as buttonslider %}
{% block robots %}<meta name="robots" content="noindex, nofollow"/>{% endblock %}
{% block title %}visualbear - Sports E-commerce Redesign{% endblock %}
{% block config %}
    {% set baseUrl = "../" %}
{% endblock %}
{% block bodyattrs %} class="cs-pink-page"{% endblock %}
{% block content %}
    <article class="section section-top-padding case-study cs-pink" id="sports_ecommerce_container">
        <section class="gallery-container">
            <div class="container">
                <div class="document-text text-box">

                    <!-- ============================================================= -->
                    <!-- CASE STUDY 1: E-COMMERCE REDESIGN                             -->
                    <!-- ============================================================= -->

                    <!-- 01 HERO COVER, from the page md's front matter (DR-0001; cover split out per case-study-nav-v2 DR-0004) -->
                    {{ site.data.pages['sports-ecommerce-redesign'] | mdcover | safe }}

                    <!-- 02 SECTION NAV directly under the hero cover, from the page md's nav: list (case-study-nav-v2 T1) -->
                    {{ site.data.pages['sports-ecommerce-redesign'] | mdtoc | safe }}

                    <!-- 03 HERO META band (needs/metrics), after the nav -->
                    {{ site.data.pages['sports-ecommerce-redesign'] | mdherometa | safe }}

                    {{ site.data.pages['sports-ecommerce-redesign'] | mdpage | safe }}
                </div>
            </div>
            {{buttonslider.content({
            nexthref: site.data.project_sports_ecommerce.nexthref,
            prevhref: site.data.project_sports_ecommerce.prevhref,
            text: var.linkname
            })}}
        </section>
    </article>
{% endblock %}
