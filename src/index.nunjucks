{% extends '_layouts/gallery.nunjucks' %}

{% block bodyattrs %} class="home-page"{% endblock %}


{% import "_modules/organisms/gallery/gallery.nunjucks" as gallery %}
{% import "_modules/molecules/card/card.nunjucks" as card %}

{% import "_modules/organisms/hero/hero.nunjucks" as hero %}

{% block content %}


{{hero.content({content:site.data.index,class:hero-about})}}

<div id="work">
{# play-consistency T1 (DR-0001): no Play teaser card - the work gallery
   renders only the data cards (bottom-flagged ones last) #}
{{gallery.content({content:site.data.work, contentType:'', showBlog:false})}}
</div>
<article class="section section-top-padding" id="about">
		<section class="gallery-container">
			
			<div class="container--padded">
				<!-- Ticket 23 (mobile eval): the bare br line boxes
				     (and the one flush gap they hid) are retired; the dead
				     inline scroller handlers are gone (scroller is
				     defined nowhere; the site's smooth-scroll init owns
				     same-page anchors). Ticket 28 (amend pass
				     2026-11-13b): no scoped paragraph margin (Pedro
				     removed it) - the copy's paragraphs sit flush.
				     .about-copy stays as the two copies' scoping hook. -->
				<div class="document-text text-box about-copy">
					<div class="headshot-container">
						<img src="../images/misc/profile_photo.png" alt="Pedro Björn" height="192" width="192">
					</div>
					<p>
						Hi! I'm <b>Pedro Björn</b>.
					</p>
					<p>
						I'm a <b>Stockholm</b> based designer, currently a <b>Design Lead</b>
						at <a href="https://www.quizrr.se/" target="_blank"><b>Quizrr</b></a>, empowering workers in supply chains through education and eLearning, leveraging AI and Design.
					</p>
					<p>
						I have worked for a decade with digital experiences such as <b>apps</b> and <b>websites</b>, with my expertise is in <b>UX (User Experience)</b>, <b>UI (User Interface)</b>, and <b>visual design</b>. I also have experience with <b>AI Design</b>, <b>Design Operations</b>, <b>front-end development</b> and <b>data analysis</b>.
					</p>

					<p>
						I love <b>design</b>, <b>technology</b> and <b>art</b>, which is why I really enjoy bringing them together to create something new.
					</p>
					<p>Feel free to <a href="../#work" class="highlight"><b>check out my work</b></a>,
					my <a href="../resume" class="highlight"><b>resume</b></a>, and don't forget to
					<a href="#contact" class="highlight"><b>say hello!</b></a></p>

				</div>
			</div>

		</section>
	</article>

	{# the robot pill on the public home (specs/visualbear-system DR-0008,
	   tickets 20/18/17; href retargeted by ticket 30 / DR-0010): fixed
	   bottom-left, above every content surface, linking to the PUBLIC
	   system page workflow/ (duplicated to the root by DR-0010). The
	   data-vb-public-pill marker is what the mirror injector's strip
	   targets - the href alone would collide with the mirror's own
	   depth-0 robot (also href="workflow/"). Same 44x44 geometry as the
	   mirror's injected pill; the mirror injector strips this one before
	   injecting its own. Hover/focus expansion and the transparent plate
	   live in _pages.scss. #}
	<a class="robot" data-vb-public-pill href="workflow/" title="The visualbear system" aria-label="The visualbear system" style="position:fixed;bottom:12px;left:12px;width:44px;height:44px;z-index:3;display:flex;align-items:flex-end;justify-content:flex-start;text-decoration:none;line-height:1;"><span class="robot-glyph" aria-hidden="true" style="font-size:20px;">🤖</span><span class="robot-pill" aria-hidden="true">workflow &amp; design system</span></a>

{% endblock %}
