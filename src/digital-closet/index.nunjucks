{% extends "_layouts/work.nunjucks" %}
{% import "_modules/molecules/buttonslider/buttonslider.nunjucks" as buttonslider %}
{% block config %}
    {% set baseUrl = "../" %}
{% endblock %}
{% block content %}
    <article class="section section-top-padding case-study" id="digital_closet_container">
        <section class="gallery-container">
            <div class="black-bg">
                <img src="../images/work/thumbs/gallery_thumb_closet.jpg" title="My Closet — Digital Feature" width="100%" height="100%" style="margin-bottom:-12px">
            </div>
            <div class="container">
                <div class="document-text text-box">

                    <!-- 01 DEFINITION -->
                    <header class="cs-hero">
                        <p class="cs-eyebrow">Case Study — Digital Feature</p>
                        <h1>My Closet</h1>
                        <p class="cs-subtitle">
                            A digital closet showing customers the apparel they already own — built to increase Member engagement, and delivered in record time.
                        </p>
                        <p class="cs-byline">Pedro Björn · Lead UX Design · 5 months concept-to-delivery (a company record)</p>

                        <blockquote class="cs-pullquote">
                            "How might we bring back our customers using clothes they already own?"
                        </blockquote>

                        <div class="cs-cards">
                            <div class="cs-card">
                                <h3>Customer needs</h3>
                                <p>"I want to look and feel good." The untapped potential sat in the clothes customers had already bought from us.</p>
                            </div>
                            <div class="cs-card">
                                <h3>Business goals</h3>
                                <p>Increase engagement (return rate, session length, pages/session) and relevance (add-to-cart, conversion) — sustainably, by building on existing apparel.</p>
                            </div>
                            <div class="cs-card">
                                <h3>Approach</h3>
                                <p>Leverage existing purchase-history data, with a hard 5-month delivery target.</p>
                            </div>
                        </div>
                    </header>

                    <!-- 02 EXPLORATION -->
                    <section class="cs-section" id="exploration">
                        <h2>Exploration</h2>

                        <h3>Research</h3>
                        <p>
                            Six formative interviews about customers' real closets, categorised into four Jobs-to-be-Done:
                        </p>
                        <ol class="cs-steps">
                            <li class="cs-step">
                                <span class="cs-number">01</span>
                                <div><h4>I want to look and feel good</h4></div>
                            </li>
                            <li class="cs-step">
                                <span class="cs-number">02</span>
                                <div><h4>I want my wardrobe to last</h4></div>
                            </li>
                            <li class="cs-step">
                                <span class="cs-number">03</span>
                                <div><h4>I want to keep my wardrobe organised</h4></div>
                            </li>
                            <li class="cs-step">
                                <span class="cs-number">04</span>
                                <div><h4>I want to get rid of my clothes</h4></div>
                            </li>
                        </ol>

                        <h3>Competitive analysis</h3>
                        <p>Twelve apps and services covering these needs were reviewed for patterns and gaps.</p>

                        <h3>Ideation</h3>
                        <p>Two Design Studios:</p>
                        <ul class="cs-facts">
                            <li>Blue-sky ideation with 11 participants, affinity-mapped into a backlog.</li>
                            <li>Clustered and refined sketches, voted down to the strongest concepts.</li>
                        </ul>

                        <h3>Customer voices</h3>
                        <div class="cs-quotes">
                            <div class="cs-quote">
                                <p>"I run out of space — I get rid of clothes."</p>
                            </div>
                            <div class="cs-quote">
                                <p>"When I have time I organise it and make it easier to find."</p>
                            </div>
                            <div class="cs-quote">
                                <p>"It'll be a mini closet which will show clothes I like or I'd like to try."</p>
                            </div>
                        </div>
                    </section>

                    <!-- 03 DISCOVERY -->
                    <section class="cs-section" id="discovery">
                        <h2>Discovery</h2>
                        <p class="cs-section-intro">
                            A defined user flow and basic functionality fed straight into a fast prototype — the three screens below.
                        </p>

                        <div class="cs-comparison">
                            <div class="cs-panel">
                                <span class="cs-tag">Flow 01</span>
                                <h3>Login</h3>
                                <p>The Closet was reached through the existing Sign-up / Sign-in flow, with expectations set before and after login. An empty state routed brand-new shoppers to the store immediately.</p>
                                <div class="cs-frame">
                                    <span class="cs-frame-label"><strong>Login Flow</strong>Final mockup pending</span>
                                </div>
                            </div>
                            <div class="cs-panel">
                                <span class="cs-tag">Flow 02 — the signature piece</span>
                                <h3>Closet View</h3>
                                <p>All previously purchased items, gathered and categorised. Swipable product sliders with a clothes-hanger feel — clothing shown clean, without detail clutter — an intro message, vertically scrollable categories, filterable and sortable.</p>
                                <div class="cs-frame cs-frame--tall">
                                    <span class="cs-frame-label"><strong>Closet View — Hanger Slider</strong>The signature piece · final mockup pending</span>
                                </div>
                            </div>
                            <div class="cs-panel">
                                <span class="cs-tag">Flow 03</span>
                                <h3>Details</h3>
                                <p>Tapping a product opened a bottom sheet with an image gallery, product info and options: care information, styling recommendations and buy-again.</p>
                                <div class="cs-frame">
                                    <span class="cs-frame-label"><strong>Details Flow</strong>Final mockup pending</span>
                                </div>
                            </div>
                        </div>

                        <h3>Validation</h3>
                        <p>
                            Five usability studies (desirability and time-on-task) refined the final design. Backlog additions from the studies: tagging/favouriting items, and adding items not bought from us.
                        </p>
                        <div class="cs-quotes">
                            <div class="cs-quote">
                                <p>"It's showing me what's in my wardrobe."</p>
                            </div>
                            <div class="cs-quote">
                                <p>"I can narrow down to just see my trousers."</p>
                            </div>
                            <div class="cs-quote">
                                <p>"I can look how they look together, comparing."</p>
                            </div>
                            <div class="cs-quote">
                                <p>"I don't think I'd ever use this feature."</p>
                            </div>
                        </div>
                    </section>

                    <!-- 04 DELIVERY -->
                    <section class="cs-section" id="delivery">
                        <h2>Delivery</h2>
                        <ol class="cs-steps">
                            <li class="cs-step">
                                <span class="cs-number">01</span>
                                <div>
                                    <h3>Design System</h3>
                                    <p>All components built on the established Design System.</p>
                                </div>
                            </li>
                            <li class="cs-step">
                                <span class="cs-number">02</span>
                                <div>
                                    <h3>Handoff</h3>
                                    <p>Developers embedded throughout — a clean handoff.</p>
                                </div>
                            </li>
                            <li class="cs-step">
                                <span class="cs-number">03</span>
                                <div>
                                    <h3>Live study</h3>
                                    <p>A live study on the production feature, with learnings documented for the next iteration.</p>
                                </div>
                            </li>
                        </ol>
                    </section>

                    <!-- 05 OUTCOME -->
                    <section class="cs-section" id="outcome">
                        <h2>Outcome</h2>

                        <div class="cs-metrics">
                            <div class="cs-metric">
                                <span class="cs-metric-value" data-countup="10">10</span><span class="cs-metric-suffix">%</span>
                                <span class="cs-metric-label">session length increase</span>
                            </div>
                            <div class="cs-metric">
                                <span class="cs-metric-value"><i class="ph ph-arrow-up"></i></span>
                                <span class="cs-metric-label">sign-in correlation from the Closet page</span>
                            </div>
                            <div class="cs-metric">
                                <span class="cs-metric-value">5 mo</span>
                                <span class="cs-metric-label">concept-to-delivery, a company record</span>
                            </div>
                        </div>

                        <div class="cs-twocol">
                            <div class="cs-col">
                                <h3>Win</h3>
                                <ul>
                                    <li>Stickiness validated in studies and live.</li>
                                    <li>Record-setting delivery.</li>
                                </ul>
                            </div>
                            <div class="cs-col">
                                <h3>Hard truth</h3>
                                <ul>
                                    <li>Feature was heavy and expensive on the backend.</li>
                                    <li>Only a portion of customers' wardrobes was represented — limited usefulness.</li>
                                    <li>Flagged to stakeholders early.</li>
                                    <li>Served as a learning MVP.</li>
                                    <li>Sunsetted after one year.</li>
                                </ul>
                            </div>
                        </div>

                        <p class="cs-summary"><em>A feature measured not just by what it achieved, but by what it taught the team.</em></p>
                    </section>
                </div>
            </div>
            {{buttonslider.content({
            nexthref: site.data.project_digital_closet.nexthref,
            prevhref: site.data.project_digital_closet.prevhref,
            text: var.linkname
            })}}
        </section>
    </article>
{% endblock %}
