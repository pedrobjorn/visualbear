{% extends "_layouts/work.nunjucks" %}
{% import "_modules/organisms/headline/headline.nunjucks" as headline %}
{% import "_modules/molecules/buttonslider/buttonslider.nunjucks" as buttonslider %}
{% block config %}
    {% set baseUrl = "../" %}
{% endblock %}
{% block content %}
    <article class="section section-top-padding" id="digital_closet_container">
        <section class="gallery-container">
            <div class="black-bg">
                {{headline.content({content:site.data.project_digital_closet})}}
                <img src="../images/work/thumbs/gallery_thumb_closet.jpg" title="My Closet - Digital Feature" width="100%" height="100%" style="margin-bottom:-12px">
            </div>
            <div class="container">
                <div class="document-text text-box">
                    <!-- 01 DEFINITION -->
                    <section class="definition-section">
                        <p class="eyebrow">Case Study — Digital Feature</p>
                        <h1>My Closet</h1>
                        <p class="subtitle">A digital closet feature showing customers the apparel they already own — built to increase Member engagement in record time.</p>
                        <p class="byline">Pedro Björn · 5 months concept-to-delivery (company record)</p>
                        
                        <blockquote class="problem-statement">
                            "How might we bring back our customers using clothes they already own?"
                        </blockquote>
                        
                        <div class="definition-columns">
                            <div class="definition-column">
                                <h3>Customer needs</h3>
                                <p>"I want to look and feel good" — untapped potential in clothes already bought from us</p>
                            </div>
                            <div class="definition-column">
                                <h3>Business goals</h3>
                                <p>Increase engagement (return rate, session length, pages/session); relevance (add-to-cart, conversion); sustainability via building on existing apparel</p>
                            </div>
                            <div class="definition-column">
                                <h3>Approach</h3>
                                <p>Leverage existing data (purchase history); 5-month delivery target</p>
                            </div>
                        </div>
                    </section>

                    <!-- 02 EXPLORATION -->
                    <section class="exploration-section">
                        <h2>Exploration</h2>
                        
                        <div class="research-subsection">
                            <h3>Research</h3>
                            <p>6 formative interviews about customers' real closets → categorised into 4 Jobs-to-be-done:</p>
                            <div class="jobs-cards">
                                <div class="job-card">
                                    <span class="job-number">01</span>
                                    <h4>I want to look and feel good</h4>
                                </div>
                                <div class="job-card">
                                    <span class="job-number">02</span>
                                    <h4>I want my wardrobe to last</h4>
                                </div>
                                <div class="job-card">
                                    <span class="job-number">03</span>
                                    <h4>I want to keep my wardrobe organised</h4>
                                </div>
                                <div class="job-card">
                                    <span class="job-number">04</span>
                                    <h4>I want to get rid of my clothes</h4>
                                </div>
                            </div>
                        </div>
                        
                        <div class="research-subsection">
                            <h3>Competitive Analysis</h3>
                            <p>12 apps/services covering these needs</p>
                        </div>
                        
                        <div class="research-subsection">
                            <h3>Ideation</h3>
                            <p>2 Design Studios:</p>
                            <ul>
                                <li>(1) Blue-sky ideation, 11 participants, affinity mapping → backlog</li>
                                <li>(2) Cluster and refine sketches, vote on best</li>
                            </ul>
                        </div>
                        
                        <div class="quotes-carousel">
                            <h3>Customer Quotes</h3>
                            <div class="quote-grid">
                                <div class="quote-card">
                                    <p>"I run out of space — I get rid of clothes"</p>
                                </div>
                                <div class="quote-card">
                                    <p>"When I have time I organise it and make it easier to find"</p>
                                </div>
                                <div class="quote-card">
                                    <p>"It'll be a mini closet which will show clothes I like or I'd like to try"</p>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- 03 DISCOVERY -->
                    <section class="discovery-section">
                        <h2>Discovery</h2>
                        <p><strong>Refinement:</strong> Defined user-flow + basic functionality → fast prototype</p>
                        
                        <div class="flows-section">
                            <h3>Flows</h3>
                            
                            <div class="flow-mockup">
                                <h4>01 Login</h4>
                                <p>Closet accessed via existing Sign-up/-in flow; expectations set before and after login; empty state routes new shoppers to store immediately</p>
                                <!-- Placeholder for HTML/CSS mockup -->
                                <div class="mockup-placeholder flow-mockup-placeholder" style="background: #f5f5f5; height: 250px; border: 1px solid #ccc; margin: 20px 0;">
                                    <p style="text-align: center; padding-top: 100px;">Login Flow Mockup<br><small>(HTML/CSS Component)</small></p>
                                </div>
                            </div>
                            
                            <div class="flow-mockup">
                                <h4>02 Closet View</h4>
                                <p>All previously purchased items gathered, categorised; swipable product sliders (clothes-hanger feel — clothing shown without details); intro message; vertically scrollable categories; filterable + sortable</p>
                                <!-- Placeholder for HTML/CSS mockup - this is the signature piece -->
                                <div class="mockup-placeholder flow-mockup-placeholder hanger-slider" style="background: #f0f0f0; height: 350px; border: 1px solid #ccc; margin: 20px 0;">
                                    <p style="text-align: center; padding-top: 140px;">Closet View - Hanger Slider<br><small>(HTML/CSS Component - Signature Piece)</small></p>
                                </div>
                            </div>
                            
                            <div class="flow-mockup">
                                <h4>03 Details</h4>
                                <p>Tap product → bottom sheet with image gallery, product info, options: care information, styling recommendations, buy again</p>
                                <!-- Placeholder for HTML/CSS mockup -->
                                <div class="mockup-placeholder flow-mockup-placeholder" style="background: #f5f5f5; height: 250px; border: 1px solid #ccc; margin: 20px 0;">
                                    <p style="text-align: center; padding-top: 100px;">Details Flow Mockup<br><small>(HTML/CSS Component)</small></p>
                                </div>
                            </div>
                        </div>
                        
                        <div class="validation-subsection">
                            <h3>Validation</h3>
                            <p>5 usability studies (desirability + time-on-task) → refined final design; backlog additions: tag/favourite items, add items not bought from us</p>
                            
                            <h4>Study Quotes:</h4>
                            <ul class="study-quotes">
                                <li>"It's showing me what's in my wardrobe"</li>
                                <li>"I can narrow down to just see my trousers"</li>
                                <li>"I can look how they look together comparing"</li>
                                <li class="counter-point">"I don't think I'd ever use this feature"</li>
                            </ul>
                        </div>
                    </section>

                    <!-- 04 DELIVERY -->
                    <section class="delivery-section">
                        <h2>Delivery</h2>
                        <div class="delivery-steps">
                            <div class="delivery-step">
                                <span class="step-number">01</span>
                                <p>All components built on the established Design System</p>
                            </div>
                            <div class="delivery-step">
                                <span class="step-number">02</span>
                                <p>Developers already embedded throughout, clean handoff</p>
                            </div>
                            <div class="delivery-step">
                                <span class="step-number">03</span>
                                <p>Live study on production feature, learnings documented for next iteration</p>
                            </div>
                        </div>
                    </section>

                    <!-- 05 OUTCOME -->
                    <section class="outcome-section">
                        <h2>Outcome</h2>
                        
                        <div class="metrics-container">
                            <div class="metric-card">
                                <span class="metric-value" data-countup="10">0</span><span class="metric-suffix">%</span>
                                <span class="metric-label">session length increase</span>
                            </div>
                            <div class="metric-card">
                                <span class="metric-value">↑</span>
                                <span class="metric-label">sign-in correlation from Closet page</span>
                            </div>
                            <div class="metric-card">
                                <span class="metric-value">5 mo</span>
                                <span class="metric-label">concept-to-delivery</span>
                            </div>
                        </div>
                        
                        <div class="lessons-section">
                            <h3>Lessons</h3>
                            <div class="lessons-columns">
                                <div class="lessons-column">
                                    <h4>Win</h4>
                                    <ul>
                                        <li>Validated stickiness</li>
                                        <li>Record delivery</li>
                                    </ul>
                                </div>
                                <div class="lessons-column">
                                    <h4>Hard truth</h4>
                                    <ul>
                                        <li>Feature heavy/expensive on backend</li>
                                        <li>Only a portion of customers' wardrobes represented → limited usefulness</li>
                                        <li>Flagged early to stakeholders</li>
                                        <li>Served as learning MVP</li>
                                        <li>Sunsetted after one year</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                        
                        <p class="closing-line"><em>A feature measured not just by what it achieved, but by what it taught the team.</em></p>
                    </section>
                </div>
            </div>
            {{buttonslider.content({
            nexthref: site.data.project_digital_closet.nexthref,
            prevhref: site.data.project_digital_closet.prevhref,
            text: var.linkname
            })}}
        </section>
    </article>
{% endblock %}
