{% extends "_layouts/work.nunjucks" %}
{% import "_modules/molecules/buttonslider/buttonslider.nunjucks" as buttonslider %}
{% block robots %}<meta name="robots" content="noindex, nofollow"/>{% endblock %}
{% block title %}visualbear - My Closet, Digital Closet Feature{% endblock %}
{% block config %}
    {% set baseUrl = "../" %}
{% endblock %}
{% block content %}
    <article class="section section-top-padding case-study" id="digital_closet_container">
        <section class="gallery-container">
            <div class="container">
                <div class="document-text text-box">

                    <!-- 01 HERO COVER, from the page md's front matter (DR-0001; cover split out per case-study-nav-v2 DR-0004) -->
                    {{ site.data.pages['digital-closet'] | mdcover | safe }}

                    <!-- 02 SECTION NAV directly under the hero cover, from the page md's nav: list (case-study-nav-v2 T1) -->
                    {{ site.data.pages['digital-closet'] | mdtoc | safe }}

                    <!-- 03 HERO META band (needs/metrics), after the nav -->
                    {{ site.data.pages['digital-closet'] | mdherometa | safe }}

                    {{ site.data.pages['digital-closet'] | mdpage | safe }}
                </div>
            </div>
            {{buttonslider.content({
            nexthref: site.data.project_digital_closet.nexthref,
            prevhref: site.data.project_digital_closet.prevhref,
            text: var.linkname
            })}}
        </section>
    </article>
{% endblock %}
