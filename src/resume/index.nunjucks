{% extends '_layouts/resume.nunjucks' %}

{% block bodyattrs %} class="resume-page"{% endblock %}

{% import "resume/_resume_blocks/resume.title.nunjucks" as title %}
{% import "resume/_resume_blocks/resume.end.nunjucks" as end %}
{% block config %}
  {# Correct base url pathing for this page #}
  {% set baseUrl = '../' %}
{% endblock %}
{% block content %}
  <section class="section section-top-padding"  id="resume_container">
    <article class="text-container">

      <!--Title Row-->
      <header class="row">
        {{title.content()}}
      </header>

      <!-- Content: summary, skills, experience, education, languages,
           interests — edited in src/_data/pages/resume.md -->
      {{ site.data.pages['resume'] | mdresume | safe }}

      <!--Download Resume Row-->
      <div class="row">
        {{end.content()}}
      </div>
    </article>
  </section>


{% endblock %}
