{% macro content(spec) %}
{% set spec = spec or {} %}
{% set _class = spec.class or '' %}
{% set _content = spec.content or '{}' %}
{% block config %}
  {# Correct base url pathing for this page #}
  {% set baseUrl = '../' %}
{% endblock %}

<div class="row">
  <div class="col m12">
    <h3 class="sub-title">Core Skills</h3>
    <ul class="no-bullets">
      <li>
        <h4 class="sub-title">Design Leadership</h4>
        <ul class="no-bullets">
          <li>Leading and coaching Product Designers in growth and craft</li>
          <li>setting product and brand design principles</li>
          <li>Design Ops: setting research, critique and delivery standards</li>
        </ul>
      </li>
      <li>
        <h4 class="sub-title">Product Design</h4>
        <ul class="no-bullets">
          <li>User Experience (UX)</li>
          <li>User Interfaces (UI)</li>
          <li>Design Systems</li>
          <li>Usability Research</li>
        </ul>
      </li>
      <li>
        <h4 class="sub-title">Technical</h4>
        <ul class="no-bullets">
          <li>Agentic Design and Prototyping (Claude Code, Cursor, Figma AI, etc)</li>
          <li>Figma</li>
          <li>Front-end fundamentals (HTML, CSS, JavaScript)</li>
          <li>Notion</li>
          <li>Jira</li>
        </ul>
      </li>
    </ul>
  </div>
</div>
  
{% endmacro %}
