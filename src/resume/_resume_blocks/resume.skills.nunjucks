{% macro content(spec) %}
{% set spec = spec or {} %}
{% set _class = spec.class or '' %}
{% set _content = spec.content or '{}' %}
{% block config %}
  {# Correct base url pathing for this page #}
  {% set baseUrl = '../' %}
{% endblock %}

<div class="row">
  <div class="col m4 s12">
    <h3 class="sub-title">Design Leadership</h3>
    <ul>
      <li>
        Design Strategy
      </li>
      <li>
        Cross-functional collaboration
      </li>
      <li>
        Design ops
      </li>
      <li>
        Mentorship
      </li>
    </ul>
  </div>
  <div class="col m4 s12">
    <h3 class="sub-title">Product Design</h3>
    <ul>
      <li>
        UX/UI
      </li>
      <li>
        Design Systems
      </li>
      <li>
        User Research
      </li>
