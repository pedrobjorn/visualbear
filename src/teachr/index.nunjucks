{% extends "_layouts/work.nunjucks" %}
{% import "_modules/molecules/buttonslider/buttonslider.nunjucks" as buttonslider %}
{% block title %}visualbear - Teachr, Redesigning the Learning Experience{% endblock %}

{% block description %}Pedro Björn Portfolio website{% endblock %}

{# gated by teachr/index.php (plan-teachr-password.md, A2) — not for search #}
{% block robots %}<meta name="robots" content="noindex, nofollow"/>{% endblock %}

{% block bodyattrs %} class="cs-teal-page"{% endblock %}

{% block config %}
    {% set baseUrl = "../" %}
{% endblock %}

{% block content %}
    <article class="section section-top-padding case-study cs-teal" id="teachr_container">
        <section class="gallery-container">
            <div class="container">
                <div class="document-text text-box">

                    <!-- 01 HERO COVER, from the page md's front matter (DR-0001; cover split out per case-study-nav-v2 DR-0004) -->
                    {{ site.data.pages['teachr'] | mdcover | safe }}

                    					<!-- 02 SECTION NAV, derived from the page md's ## titles (case-study-nav T1) -->
					{{ site.data.pages['teachr'] | mdtoc | safe }}

					<!-- 03 HERO META band (needs/metrics), after the nav (case-study-nav-v2 DR-0004) -->
					{{ site.data.pages['teachr'] | mdherometa | safe }}

					<!-- content sections: src/_data/pages/teachr.md via mdpage -->
					{{ site.data.pages['teachr'] | mdpage | safe }}


				</div>
			</div>
			{{buttonslider.content({
			nexthref: site.data.project_teachr.nexthref,
			prevhref: site.data.project_teachr.prevhref,
			text: var.linkname
			})}}
		</section>
    </article>
{% endblock %}
