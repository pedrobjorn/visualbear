{% extends '_layouts/work.nunjucks' %}
{% import "_modules/organisms/headline/headline.nunjucks" as headline %}

{% import "_modules/molecules/buttonslider/buttonslider.nunjucks" as buttonslider %}
{% block config %}
	{# Correct base url pathing for this page #}
	{% set baseUrl = '../' %}
{% endblock %}
{% block content %}
	<article class="section section-top-padding" id="lynx_container">
		<section class="gallery-container">
			
			{{headline.content({content:site.data.project_lynx,class:hero-about})}}
			
			<div class="container--padded">
				<div class="document-text text-box">
					<!-- Ticket 31 (visualbear-system): the img alts below are [ai]-drafted from the real file names + project context - Pedro's wording pass (Gate 7) owns the final strings. The invalid alt= on wrapper <a> tags was removed; each gallery link takes its accessible name from its img's alt. -->
<div class="gallery-image">
						<a href="../images/work/fullsize/lynx/lynx_redesign.jpg">
							<img alt="Projecto Lynx redesign process image" src="../images/work/fullsize/lynx/lynx_redesign.jpg" title="Projecto Lynx redesign process image"  width="1024" height="483">
						</a>
						<a href="../images/work/fullsize/lynx/lynx_iterations.jpg">
							<img alt="Projecto Lynx logo iterations image" src="../images/work/fullsize/lynx/lynx_iterations.jpg" title="Projecto Lynx logo iterations image"  width="1024" height="483">
						</a>
						<a href="../images/work/fullsize/lynx/lynx_first.jpg">
							<img alt="Projecto Lynx logo image" src="../images/work/fullsize/lynx/lynx_first.jpg" title="Projecto Lynx logo image" width="1024" height="484">
						</a>
						<a href="../images/work/fullsize/lynx/lynx_alt.jpg">
							<img alt="Projecto Lynx alternate logo image" src="../images/work/fullsize/lynx/lynx_alt.jpg" title="Projecto Lynx alternate logo image" width="1024" height="480">
						</a>
						<a href="../images/work/fullsize/lynx/lynx_small.jpg">
							<img alt="Projecto Lynx small logo image" src="../images/work/fullsize/lynx/lynx_small.jpg" title="Projecto Lynx small logo image" width="1024" height="483">
						</a>
						<a href="../images/work/fullsize/lynx/lynx_bw.jpg">
							<img alt="Projecto Lynx black and white logo image" src="../images/work/fullsize/lynx/lynx_bw.jpg" title="Projecto Lynx black and white logo image"  width="1024" height="490">
						</a>
						<a href="../images/work/fullsize/lynx/lynx_card.jpg">
							<img alt="Projecto Lynx post card example image" src="../images/work/fullsize/lynx/lynx_card.jpg" title="Projecto Lynx post card example image" width="1024" height="482">
						</a>
						<a href="../images/work/fullsize/lynx/lynx_print.jpg">
							<img alt="Projecto Lynx printed logo photo" src="../images/work/fullsize/lynx/lynx_print.jpg" title="Projecto Lynx printed logo photo" width="1024" height="490">
						</a>
						<a href="../images/work/fullsize/lynx/lynx_pres.jpg">
							<img alt="Projecto Lynx application image" src="../images/work/fullsize/lynx/lynx_pres.jpg" title="Projecto Lynx application image" width="1024" height="930">
						</a>
					</div>
				</div>
			</div>
                          {{buttonslider.content({
          nexthref: site.data.project_lynx.nexthref,
          prevhref: site.data.project_lynx.prevhref,
          text: var.linkname
          })}}
		</section>
	</article>
{% endblock %}